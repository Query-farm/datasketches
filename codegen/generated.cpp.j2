void Load{{ S }}Sketch(ExtensionLoader &loader) {
{% if sketch.counting %}
    auto sketch_type = DSCreateSketchType(loader, "sketch_{{ sketch.sql }}", "Sketch type for {{ S }} sketch");
{% else %}
    std::unordered_map<LogicalTypeId, LogicalType> sketch_map_types;
{% for item_type in sketch.item_types %}
    sketch_map_types[{{ to_type_id(item_type) }}] = DSCreateSketchType(loader, "sketch_{{ sketch.sql }}_{{ type_name(item_type)|lower }}", "Sketch type for {{ S }} sketch with embedded type {{ type_name(item_type) }}");
{% endfor %}
{% endif %}

{% for function in scalar_functions(sketch) %}
    {
        ScalarFunctionSet set("datasketch_{{ sketch.sql }}_{{ function.name }}");
        vector<FunctionDescription> descriptions;
{% for item_type in sketch.overload_types %}
        DSAddScalar(set, descriptions,
                    ScalarFunction({ {{ parameter_types(function, item_type) }} }, {{ function.returns.logical(item_type) }},
                                   DS{{ S }}{{ function.name }}{% if item_type %}<{{ cpp_type[item_type] }}>{% endif %}),
                    { {{ parameter_names(function) }} }, {{ function.description|cpp_string }},
                    { {{ function.example|cpp_string }} });
{% endfor %}
        DSRegisterScalars(loader, std::move(set), std::move(descriptions), {"sketch", "{{ sketch.sql }}"});
    }
{% endfor %}

    {
        AggregateFunctionSet set("datasketch_{{ sketch.sql }}");
        vector<FunctionDescription> descriptions;
{% for item_type in sketch.item_types %}
{% set sketch_type = "sketch_type" if sketch.counting else "sketch_map_types[" ~ to_type_id(item_type) ~ "]" %}
{% set create = "DS" ~ S ~ "CreateAggregate<" ~ cpp_type[item_type] ~ ">(" ~ item_type ~ ", " ~ sketch_type ~ ")" %}
        DSAddAggregate(set, descriptions, {{ create }}, DS{{ S }}Bind,
                       { {{ k_logical_type }}, {{ item_type }} }, {"k", "data"},
                       "Creates a sketch_{{ sketch.sql }} data sketch by aggregating values",
                       { {{ examples.create|cpp_string }} });
{% if option %}
        DSAddAggregate(set, descriptions, {{ create }}, DS{{ S }}Bind,
                       { {{ k_logical_type }}, {{ item_type }}, {{ option.logical_type }} }, {"k", "data", "{{ option.name }}"},
                       {{ ("Creates a sketch_" ~ sketch.sql ~ " data sketch by aggregating values. " ~ option.create_note)|cpp_string }},
                       { {{ examples.create_option|cpp_string }} });
{% endif %}
{% if not sketch.counting %}
        DSAddAggregate(set, descriptions, DS{{ S }}MergeAggregate<{{ cpp_type[item_type] }}>({{ item_type }}, {{ sketch_type }}), DS{{ S }}Bind,
                       { {{ k_logical_type }}, {{ sketch_type }} }, {"k", "sketch"},
                       "Creates a sketch_{{ sketch.sql }} data sketch by merging other {{ S }} data sketches",
                       { {{ examples.merge|cpp_string }} });
{% endif %}
{% endfor %}
        DSRegisterAggregates(loader, std::move(set), std::move(descriptions), {"sketch", "{{ sketch.sql }}"});
    }
{% if sketch.counting %}

    {
        AggregateFunctionSet set("datasketch_{{ sketch.sql }}_union");
        vector<FunctionDescription> descriptions;
        DSAddAggregate(set, descriptions, DS{{ S }}MergeAggregate(sketch_type), DS{{ S }}Bind,
                       { {{ k_logical_type }}, sketch_type }, {"k", "sketch"},
                       "Creates a sketch_{{ sketch.sql }} data sketch by aggregating other {{ S }} data sketches",
                       { {{ examples.union|cpp_string }} });
{% if option %}
        DSAddAggregate(set, descriptions, DS{{ S }}MergeAggregate(sketch_type), DS{{ S }}Bind,
                       { {{ k_logical_type }}, sketch_type, {{ option.logical_type }} }, {"k", "sketch", "{{ option.name }}"},
                       {{ ("Creates a sketch_" ~ sketch.sql ~ " data sketch by aggregating other " ~ S ~ " data sketches. " ~ option.union_note)|cpp_string }},
                       { {{ examples.union_option|cpp_string }} });
{% endif %}
        DSRegisterAggregates(loader, std::move(set), std::move(descriptions), {"sketch", "{{ sketch.sql }}"});
    }
{% endif %}
}
