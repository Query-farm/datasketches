                DSSetArguments(fun, { {{cpp_type_mapping[sketch_k_cpp_type[sketch_type]]}}, {{logical_type}}, LogicalType::BOOLEAN });
                sketch.AddFunction(fun);

                FunctionDescription desc;
                desc.description = "Creates a sketch_req data sketch by aggregating values. hra (a constant) selects high-rank accuracy (true, the default) or low-rank accuracy (false)";
                desc.examples.push_back("{{aggregate_examples(sketch_type).create_req_hra}}");
                desc.parameter_names = {"k", "data", "hra"};
                desc.parameter_types = { {{cpp_type_mapping[sketch_k_cpp_type[sketch_type]]}}, {{logical_type}}, LogicalType::BOOLEAN };
                agg_descs.push_back(std::move(desc));
            }
            {% endif %}
            {
                auto fun = DS{{sketch_type}}MergeAggregate<{{cpp_type}}>({{logical_type}}, sketch_map_types[{{to_type_id(logical_type)}}]);
                fun.SetBindCallback(DS{{sketch_type}}Bind);
                fun.SetOrderDependent(AggregateOrderDependent::NOT_ORDER_DEPENDENT);
                DSPrependArgument(fun, {{cpp_type_mapping[sketch_k_cpp_type[sketch_type]]}});
                sketch.AddFunction(fun);

                FunctionDescription desc;
                desc.description = "Creates a sketch_{{sketch_type|lower}} data sketch by merging other {{sketch_type}} data sketches";
                desc.examples.push_back("{{aggregate_examples(sketch_type).merge}}");
                desc.parameter_names = {"k", "sketch"};
                desc.parameter_types = { {{cpp_type_mapping[sketch_k_cpp_type[sketch_type]]}}, sketch_map_types[{{to_type_id(logical_type)}}] };
                agg_descs.push_back(std::move(desc));
            }
        {% endif %}
      {%- endfor %}
      CreateAggregateFunctionInfo sketch_info(sketch);
      for (auto &d : agg_descs) {
          sketch_info.descriptions.push_back(std::move(d));
      }

      DSSetCategories(sketch_info, {"sketch", "{{sketch_type|lower}}"});

      DSRegister(loader, sketch_info);
      }



      {% if sketch_type in counting_sketch_names %}
      {
      AggregateFunctionSet sketch("datasketch_{{sketch_type|lower}}_union");
      auto fun = DS{{sketch_type}}MergeAggregate(sketch_type);
      fun.SetBindCallback(DS{{sketch_type}}Bind);
      fun.SetOrderDependent(AggregateOrderDependent::NOT_ORDER_DEPENDENT);
      DSPrependArgument(fun, {{cpp_type_mapping[sketch_k_cpp_type[sketch_type]]}});
      sketch.AddFunction(fun);
      {% if sketch_type == "HLL" %}
      DSSetArguments(fun, { {{cpp_type_mapping[sketch_k_cpp_type[sketch_type]]}}, sketch_type, LogicalType::VARCHAR });
      sketch.AddFunction(fun);
      {% endif %}
      CreateAggregateFunctionInfo sketch_info(sketch);

    {
        FunctionDescription desc;
        desc.description = "Creates a sketch_{{sketch_type}} data sketch by aggregating other {{sketch_type}} data sketches";
        desc.examples.push_back("{{aggregate_examples(sketch_type).union}}");
        desc.parameter_names = {"k", "sketch"};
        desc.parameter_types = { {{cpp_type_mapping[sketch_k_cpp_type[sketch_type]]}}, sketch_type };
        sketch_info.descriptions.push_back(desc);
