static AggregateFunction DS{{ S }}MergeAggregate(const LogicalType &type, const LogicalType &result_type) {
{% if sketch.arena %}
    if constexpr (!std::is_same_v<T, string_t>) {
        using STATE = DS{{ S }}ArenaState<T>;
        using OP = DSArenaMergeOperation<DS{{ S }}BindData>;
        auto fun = AggregateFunction::UnaryAggregate<STATE, string_t, string_t, OP>(result_type, result_type);
        DSReadDataArgumentAt<1, STATE, string_t, OP>(fun);
        DSSetArenaStateExport<STATE, DS{{ S }}BindData>(fun);
        return fun;
    }
{% endif %}
    using OP = DSQuantilesMergeOperation<DS{{ S }}BindData>;
    auto fun = AggregateFunction::UnaryAggregate<DS{{ S }}State<T>, string_t, string_t, OP, AggregateDestructorType::LEGACY>(result_type, result_type);
    DSReadDataArgumentAt<1, DS{{ S }}State<T>, string_t, OP>(fun);
    return fun;
}

