  void Load{{sketch_type}}Sketch(ExtensionLoader &loader) {


      {% if sketch_type in counting_sketch_names %}
        auto sketch_type = Create{{sketch_type}}CountingSketchType(loader);
      {% else %}
        std::unordered_map<LogicalTypeId, LogicalType> sketch_map_types;
        {% for logical_type in logical_type_to_cplusplus_type(sketch_type).keys() %}
            sketch_map_types.insert({ {{to_type_id(logical_type)}}, Create{{sketch_type}}SketchType(loader, LogicalType({{to_type_id(logical_type)}}))});
        {%- endfor %}
      {% endif %}

      {% for unary_function in functions_per_sketch_type(sketch_type) %}
      {
        ScalarFunctionSet fs("datasketch_{{sketch_type|lower}}_{{unary_function.name|lower}}");
        std::vector<FunctionDescription> fn_descs;
        {% if sketch_type in counting_sketch_names %}
                fs.AddFunction(ScalarFunction(
                {{get_scalar_function_args(unary_function, None, None)}}
                ,    DS{{sketch_type}}{{unary_function.name}}));
                {
                    FunctionDescription desc;
                    desc.description = "{{unary_function.description}}";
                    desc.examples.push_back("{{unary_function.example}}");
                    desc.parameter_names = { {{get_parameter_names(unary_function)}} };
                    desc.parameter_types = { {{get_parameter_types_str(unary_function, None, None)}} };
                    fn_descs.push_back(std::move(desc));
                }
        {% else %}
            {% for logical_type, cpp_type in logical_type_to_cplusplus_type(sketch_type).items() %}
                fs.AddFunction(ScalarFunction(
                {{get_scalar_function_args(unary_function, logical_type, cpp_type)}}
                ,    DS{{sketch_type}}{{unary_function.name}}<{{cpp_type}}>));
                {
                    FunctionDescription desc;
                    desc.description = "{{unary_function.description}}";
                    desc.examples.push_back("{{unary_function.example}}");
                    desc.parameter_names = { {{get_parameter_names(unary_function)}} };
                    desc.parameter_types = { {{get_parameter_types_str(unary_function, logical_type, cpp_type)}} };
                    fn_descs.push_back(std::move(desc));
                }
            {%- endfor %}
        {% endif %}

        // Every scalar function deserializes a sketch, which throws on invalid input.
        fs.SetFallible();
        CreateScalarFunctionInfo info(std::move(fs));
        for (auto &d : fn_descs) {
            info.descriptions.push_back(std::move(d));
        }

        DSSetCategories(info, {"sketch", "{{sketch_type|lower}}"});

        DSRegister(loader, info);


      }
      {%- endfor %}

      // This funciton creates the sketches.
      {
      AggregateFunctionSet sketch("datasketch_{{sketch_type|lower}}");
      std::vector<FunctionDescription> agg_descs;
      {% for logical_type, cpp_type in logical_type_to_cplusplus_type(sketch_type).items() %}
        {% if sketch_type in counting_sketch_names %}
            {
                auto fun = DS{{sketch_type}}CreateAggregate<{{cpp_type}}>({{logical_type}}, sketch_type);
                fun.SetBindCallback(DS{{sketch_type}}Bind);
                fun.SetOrderDependent(AggregateOrderDependent::NOT_ORDER_DEPENDENT);
                DSPrependArgument(fun, {{cpp_type_mapping[sketch_k_cpp_type[sketch_type]]}});
                sketch.AddFunction(fun);

                FunctionDescription desc;
                desc.description = "Creates a sketch_{{sketch_type|lower}} data sketch by aggregating values";
                desc.examples.push_back("{{aggregate_examples(sketch_type).create}}");
                desc.parameter_names = {"k", "data"};
                desc.parameter_types = { {{cpp_type_mapping[sketch_k_cpp_type[sketch_type]]}}, {{logical_type}} };
                agg_descs.push_back(std::move(desc));
            }
            {% if sketch_type == "HLL" %}
            {
                auto fun = DS{{sketch_type}}CreateAggregate<{{cpp_type}}>({{logical_type}}, sketch_type);
                fun.SetBindCallback(DS{{sketch_type}}Bind);
                fun.SetOrderDependent(AggregateOrderDependent::NOT_ORDER_DEPENDENT);
                DSSetArguments(fun, { {{cpp_type_mapping[sketch_k_cpp_type[sketch_type]]}}, {{logical_type}}, LogicalType::VARCHAR });
                sketch.AddFunction(fun);

                FunctionDescription desc;
                desc.description = "Creates a sketch_hll data sketch by aggregating values. target_type (a constant) selects the register encoding: 'HLL_4' (the default, smallest), 'HLL_6' or 'HLL_8' (largest, fastest)";
                desc.examples.push_back("{{aggregate_examples(sketch_type).create_hll_target_type}}");
                desc.parameter_names = {"k", "data", "target_type"};
                desc.parameter_types = { {{cpp_type_mapping[sketch_k_cpp_type[sketch_type]]}}, {{logical_type}}, LogicalType::VARCHAR };
                agg_descs.push_back(std::move(desc));
            }
            {% endif %}
        {% else %}
            {
                auto fun = DS{{sketch_type}}CreateAggregate<{{cpp_type}}>({{logical_type}}, sketch_map_types[{{to_type_id(logical_type)}}]);
                fun.SetBindCallback(DS{{sketch_type}}Bind);
                fun.SetOrderDependent(AggregateOrderDependent::NOT_ORDER_DEPENDENT);
                DSPrependArgument(fun, {{cpp_type_mapping[sketch_k_cpp_type[sketch_type]]}});
                sketch.AddFunction(fun);

                FunctionDescription desc;
                desc.description = "Creates a sketch_{{sketch_type|lower}} data sketch by aggregating values";
                desc.examples.push_back("{{aggregate_examples(sketch_type).create}}");
                desc.parameter_names = {"k", "data"};
                desc.parameter_types = { {{cpp_type_mapping[sketch_k_cpp_type[sketch_type]]}}, {{logical_type}} };
                agg_descs.push_back(std::move(desc));
            }
            {% if sketch_type == "REQ" %}
            {
                auto fun = DS{{sketch_type}}CreateAggregate<{{cpp_type}}>({{logical_type}}, sketch_map_types[{{to_type_id(logical_type)}}]);
