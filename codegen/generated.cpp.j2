        const auto count = static_cast<uint32_t>((size - 1) / sizeof(ITEM));
        for (uint32_t i = 0; i < count; i++) {
            ITEM item;
            memcpy(&item, bytes + 1 + i * sizeof(ITEM), sizeof(ITEM));
            buffer.Append(item, arena);
        }
    }
};

