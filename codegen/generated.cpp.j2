static AggregateFunction DS{{ S }}MergeAggregate(const LogicalType &result_type) {
    using STATE = DS{{ S }}ArenaUnionState;
    using OP = DSArenaMergeOperation<DS{{ S }}BindData>;
    auto fun = AggregateFunction::UnaryAggregate<STATE, string_t, string_t, OP>(result_type, result_type);
    DSReadDataArgumentAt<1, STATE, string_t, OP>(fun);
    DSSetArenaStateExport<STATE, DS{{ S }}BindData>(fun);
    return fun;
}

template <class T>
static AggregateFunction DS{{ S }}CreateAggregate(const LogicalType &type, const LogicalType &result_type) {
    using INPUT = DSCountingInput<T>;
    using STATE = DS{{ S }}ArenaState<INPUT>;
    using OP = DS{{ S }}ArenaCreateOperation<INPUT::is_uuid>;
    auto fun = AggregateFunction::UnaryAggregate<STATE, typename INPUT::physical_type, string_t, OP>(type, result_type);
    DSReadDataArgumentAt<1, STATE, typename INPUT::physical_type, OP>(fun);
    DSSetArenaStateExport<STATE, DS{{ S }}BindData>(fun);
    return fun;
}
