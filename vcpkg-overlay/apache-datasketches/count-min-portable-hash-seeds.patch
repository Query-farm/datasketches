+// The hash seeds were drawn with std::default_random_engine and std::uniform_int_distribution, whose results are
+// implementation-defined: sketches built with libc++ or the MSVC standard library had other hash seeds than
+// sketches built with libstdc++, and gave wrong estimates for each other. This computes what libstdc++ does
+// (minstd_rand0, which is its default_random_engine, scaled up to 64 bits by its uniform_int_distribution
+// algorithm) on every platform.
+inline uint64_t uniform_uint64(std::minstd_rand0& urng, uint64_t urange) {
+  const uint64_t urngmin = std::minstd_rand0::min();
+  const uint64_t urngrange = std::minstd_rand0::max() - urngmin;
+  uint64_t ret;
+  if (urngrange > urange) {
+    const uint64_t uerange = urange + 1;
+    const uint64_t scaling = urngrange / uerange;
+    const uint64_t past = uerange * scaling;
+    do {
+      ret = static_cast<uint64_t>(urng()) - urngmin;
+    } while (ret >= past);
+    ret /= scaling;
+  } else if (urngrange < urange) {
+    uint64_t tmp;
+    const uint64_t uerngrange = urngrange + 1;
+    do {
+      tmp = uerngrange * uniform_uint64(urng, urange / uerngrange);
+      ret = tmp + (static_cast<uint64_t>(urng()) - urngmin);
+    } while (ret > urange || ret < tmp);
+  } else {
+    ret = static_cast<uint64_t>(urng()) - urngmin;
+  }
+  return ret;
+}
 
