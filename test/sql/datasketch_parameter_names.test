# name: test/sql/datasketch_parameter_names.test
# description: Every datasketches function overload reports real parameter names, a description and examples
# group: [datasketches]

require datasketches

# No overload may report generic (col<N>, args, kwargs, empty) or suffixed (name_1) parameter names,
# a name count that differs from its type count, or duplicate names.
query I
SELECT list(DISTINCT function_name ORDER BY function_name) FROM duckdb_functions()
WHERE function_name LIKE 'datasketch\_%' ESCAPE '\'
  AND (parameters IS NULL
       OR len(parameters) <> len(parameter_types)
       OR len(list_distinct(parameters)) <> len(parameters)
       OR len(list_filter(parameters, lambda p: p IS NULL
                                       OR regexp_matches(p, '^(col[0-9]+|args|kwargs|)$')
                                       OR regexp_matches(p, '_[0-9]+$'))) > 0);
----
NULL

# Every overload has a description and at least one example.
query I
SELECT list(DISTINCT function_name ORDER BY function_name) FROM duckdb_functions()
WHERE function_name LIKE 'datasketch\_%' ESCAPE '\'
  AND (description IS NULL OR description = '' OR examples IS NULL OR len(examples) = 0);
----
NULL

# The weighted Frequent Items aggregate names its data, weight and lg_max_k arguments.
query II
SELECT parameters, examples FROM duckdb_functions()
WHERE function_name = 'datasketch_frequent_items_weighted' AND parameter_types = ['VARCHAR', 'BIGINT'];
----
[data, weight]	['datasketch_frequent_items_weighted(column, weight)']

query II
SELECT parameters, examples FROM duckdb_functions()
WHERE function_name = 'datasketch_frequent_items_weighted' AND parameter_types = ['INTEGER', 'DOUBLE', 'UBIGINT'];
----
[lg_max_k, data, weight]	['datasketch_frequent_items_weighted(10, column, weight)']

query I
SELECT count(*) FROM duckdb_functions()
WHERE function_name = 'datasketch_frequent_items_weighted'
  AND parameters <> ['data', 'weight'] AND parameters <> ['lg_max_k', 'data', 'weight'];
----
0
