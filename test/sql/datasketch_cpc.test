# name: test/sql/datasketch_cpc.test
# description: test datasketch CPC sketches
# group: [datasketches]

# Before we load the extension, this will fail
statement error
SELECT datasketch_cpc_is_empty(''::blob);
----
Catalog Error: Scalar Function with name datasketch_cpc_is_empty does not exist!

# Require statement will ensure this test is run with this extension loaded
require datasketches

query I
SELECT datasketch_cpc(8, 5);
----
\x08\x01\x10\x08\x00\x0E\xCC\x93\x01\x00\x00\x00\x01\x00\x00\x00\x00\x00\x00\x00\x00\xF8o@\x00\x00\x00\x00\x00\x00\xF0?\xDD\x03\x00\x00

query I
SELECT datasketch_cpc_is_empty('\x08\x01\x10\x08\x00\x0E\xCC\x93\x01\x00\x00\x00\x01\x00\x00\x00\x00\x00\x00\x00\x00\xF8o@\x00\x00\x00\x00\x00\x00\xF0?\xDD\x03\x00\x00');
----
false

# Do some tests with integers.

statement ok
CREATE TABLE items(id integer)

statement ok
INSERT INTO items(id) select unnest(generate_series(1, 100000)) order by random()

# Duplicate items shouldn't affect the count.

statement ok
INSERT INTO items(id) select unnest(generate_series(1, 100000)) order by random()

query I
SELECT datasketch_cpc_is_empty(datasketch_cpc(12, id)) from items
----
false


query I
SELECT datasketch_cpc_describe(datasketch_cpc(4, id)) like '%CPC sketch summary%' from items
----
true

# Test with strings

statement ok
CREATE TABLE employees(name string)

statement ok
INSERT INTO employees(name) VALUES
('John Doe'), ('Jane Smith'), ('Michael Johnson'), ('Emily Davis'), ('Chris Brown'), ('Sarah Wilson'), ('David Martinez'),('Sophia Anderson'), ('Daniel Lee'),('Olivia Taylor');

# 10 distinct names, estimate should be close
query I
SELECT datasketch_cpc_estimate(datasketch_cpc(4, name))::int between 8 and 15 from employees
----
true

statement ok
CREATE TABLE sketches (sketch sketch_cpc)

statement ok
INSERT INTO sketches (sketch) select datasketch_cpc(12, id) from items where mod(id, 3) == 0

statement ok
INSERT INTO sketches (sketch) select datasketch_cpc(12, id) from items where mod(id, 3) == 1

statement ok
INSERT INTO sketches (sketch) select datasketch_cpc(12, id) from items where mod(id, 3) == 2

query I
select datasketch_cpc_is_empty(datasketch_cpc_union(12, sketch)) from sketches
----
false

# Test error handling for invalid/corrupted sketch data
statement error
SELECT datasketch_cpc_estimate('\x00\x01\x02\x03'::blob);
----
Invalid Input Error: Failed to deserialize CPC sketch

statement error
SELECT datasketch_cpc_is_empty('\xDE\xAD\xBE\xEF'::blob);
----
Invalid Input Error: Failed to deserialize CPC sketch

# Test with empty blob
statement error
SELECT datasketch_cpc_estimate(''::blob);
----
Invalid Input Error: Failed to deserialize CPC sketch

# =============================================================================
# COMPREHENSIVE UNION TESTS
# =============================================================================

# Test union of multiple sketches from partitioned data with non-overlapping values
statement ok
CREATE TABLE union_data(value int, partition_id int)

statement ok
INSERT INTO union_data SELECT unnest(generate_series(1, 10000)), 1

statement ok
INSERT INTO union_data SELECT unnest(generate_series(10001, 20000)), 2

statement ok
INSERT INTO union_data SELECT unnest(generate_series(20001, 30000)), 3

# Create sketches per partition
statement ok
CREATE TABLE partition_sketches AS
SELECT partition_id, datasketch_cpc(12, value) as sketch
FROM union_data
GROUP BY partition_id

# Verify we have 3 partition sketches
query I
SELECT count(*) FROM partition_sketches
----
3

# Each partition has 10000 distinct values
query I
SELECT datasketch_cpc_estimate(sketch)::int between 9500 and 10500 FROM partition_sketches ORDER BY partition_id LIMIT 1
----
true

# Union all partition sketches - should have ~30000 distinct values
query I
SELECT datasketch_cpc_estimate(datasketch_cpc_union(12, sketch))::int between 28500 and 31500 FROM partition_sketches
----
true

# Verify union is not empty
query I
SELECT datasketch_cpc_is_empty(datasketch_cpc_union(12, sketch)) FROM partition_sketches
----
false

# Verify union is not empty (already tested above, but confirms consistency)
query I
SELECT datasketch_cpc_estimate(datasketch_cpc_union(12, sketch))::int > 0 FROM partition_sketches
----
true

# Test union with overlapping data
statement ok
CREATE TABLE overlap_union_data(value int, group_id int)

statement ok
INSERT INTO overlap_union_data SELECT unnest(generate_series(1, 50000)), 1

statement ok
INSERT INTO overlap_union_data SELECT unnest(generate_series(25000, 75000)), 2

statement ok
CREATE TABLE overlap_union_sketches AS
SELECT group_id, datasketch_cpc(14, value) as sketch
FROM overlap_union_data
GROUP BY group_id

# Group 1 has 50000 distinct, Group 2 has 50001 distinct
# Union should have 75000 distinct (1-75000)
query I
SELECT datasketch_cpc_estimate(datasketch_cpc_union(14, sketch))::int between 72000 and 78000 FROM overlap_union_sketches
----
true

# Test union with different K values
statement ok
CREATE TABLE k_union_sketches AS
SELECT datasketch_cpc(8, value) as sketch FROM union_data WHERE partition_id = 1
UNION ALL
SELECT datasketch_cpc(14, value) as sketch FROM union_data WHERE partition_id = 2

# Verify union works with different K values
query I
SELECT datasketch_cpc_estimate(datasketch_cpc_union(10, sketch))::int between 18000 and 22000 FROM k_union_sketches
----
true

# Test union of single sketch (edge case)
query I
SELECT datasketch_cpc_estimate(datasketch_cpc_union(12, sketch))::int between 9500 and 10500
FROM (SELECT datasketch_cpc(12, value) as sketch FROM union_data WHERE partition_id = 1) single_sketch
----
true

# Test union preserves accuracy - lower_bound/upper_bound on union
query I
SELECT datasketch_cpc_lower_bound(datasketch_cpc_union(12, sketch), 1)::int between 27000 and 31000 FROM partition_sketches
----
true

query I
SELECT datasketch_cpc_upper_bound(datasketch_cpc_union(12, sketch), 1)::int between 29000 and 33000 FROM partition_sketches
----
true

# Test union with string values
statement ok
CREATE TABLE string_union_data(name varchar, source_id int)

statement ok
INSERT INTO string_union_data
SELECT 'user_' || x, 1 FROM generate_series(1, 1000) t(x)
UNION ALL
SELECT 'user_' || x, 2 FROM generate_series(500, 1500) t(x)

statement ok
CREATE TABLE string_union_sketches AS
SELECT source_id, datasketch_cpc(10, name) as sketch
FROM string_union_data
GROUP BY source_id

# Union should have ~1500 distinct strings (user_1 to user_1500)
query I
SELECT datasketch_cpc_estimate(datasketch_cpc_union(10, sketch))::int between 1400 and 1600 FROM string_union_sketches
----
true

# Test union with GROUP BY categories
statement ok
CREATE TABLE category_union_data(category varchar, user_id int)

statement ok
INSERT INTO category_union_data
SELECT 'electronics', unnest(generate_series(1, 5000))
UNION ALL
SELECT 'clothing', unnest(generate_series(2500, 7500))
UNION ALL
SELECT 'food', unnest(generate_series(5000, 10000))

statement ok
CREATE TABLE category_union_sketches AS
SELECT category, datasketch_cpc(12, user_id) as sketch
FROM category_union_data
GROUP BY category

# Each category has ~5000 distinct users
# Union should have ~10000 distinct users (1-10000)
query I
SELECT datasketch_cpc_estimate(datasketch_cpc_union(12, sketch))::int between 9500 and 10500 FROM category_union_sketches
----
true

# Test describe on union result
query I
SELECT datasketch_cpc_describe(datasketch_cpc_union(12, sketch)) like '%CPC sketch summary%' FROM partition_sketches
----
true

# =============================================================================
# UNION STATE: PARALLEL MERGES, MANY-ROW UNIONS, REPEATED INPUTS
# =============================================================================

statement ok
SET threads = 8;

statement ok
CREATE TABLE cpc_par AS SELECT i AS v, i % 2000 AS g FROM range(400000) t(i)

# 2000 groups of 200 distinct values: partial states on every thread, merged per group
query I
SELECT count(*) FROM (SELECT g, datasketch_cpc_estimate(datasketch_cpc(12, v)) AS e FROM cpc_par GROUP BY g) WHERE abs(e - 200) > 10
----
0

# 20 groups of 20000 distinct values: large partial states merged per group
query I
SELECT count(*) FROM (SELECT g % 20 AS h, datasketch_cpc_estimate(datasketch_cpc(12, v)) AS e FROM cpc_par GROUP BY h) WHERE abs(e - 20000) / 20000 > 0.05
----
0

statement ok
CREATE TABLE cpc_par_sketches AS SELECT g, datasketch_cpc(12, v) AS s FROM cpc_par GROUP BY g

# Union of 2000 sketches into one group
query I
SELECT abs(datasketch_cpc_estimate(datasketch_cpc_union(12, s)) - 400000) / 400000 < 0.05 FROM cpc_par_sketches
----
true

# Grouped unions agree with and without parallelism
statement ok
SET threads = 1;

statement ok
CREATE TABLE cpc_u1 AS SELECT g % 10 AS h, datasketch_cpc_estimate(datasketch_cpc_union(12, s)) AS e FROM cpc_par_sketches GROUP BY h

statement ok
SET threads = 8;

query I
SELECT count(*) FROM cpc_u1 JOIN (SELECT g % 10 AS h, datasketch_cpc_estimate(datasketch_cpc_union(12, s)) AS e FROM cpc_par_sketches GROUP BY h) u8 USING (h) WHERE abs(cpc_u1.e - u8.e) / cpc_u1.e > 0.01
----
0

# A repeated value counts once
query I
SELECT datasketch_cpc_estimate(datasketch_cpc(12, 42))::INT FROM range(10000)
----
1

# Unioning the same sketch many times equals unioning it twice
statement ok
CREATE TABLE cpc_one AS SELECT datasketch_cpc(12, v) AS s FROM cpc_par WHERE g < 100

query I
SELECT (SELECT datasketch_cpc_estimate(datasketch_cpc_union(12, s)) FROM cpc_one, range(5000)) = (SELECT datasketch_cpc_estimate(datasketch_cpc_union(12, s)) FROM cpc_one, range(2))
----
true

# A running window over the sketch merges states many times
query I
SELECT count(*) FROM (SELECT datasketch_cpc_estimate(datasketch_cpc(12, v) OVER (ORDER BY v ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)) AS e, row_number() OVER (ORDER BY v) AS n FROM (SELECT v FROM cpc_par WHERE v < 5000)) WHERE abs(e - n) / n > 0.05
----
0

# =============================================================================
# UUID, HUGEINT AND UHUGEINT INPUTS
# =============================================================================

query I
SELECT round(datasketch_cpc_estimate(datasketch_cpc(12, '00000000-0000-0000-0000-000000000001'::UUID)))::INT
----
1

# The extreme UUID values are distinct, NULLs are ignored and repeats count once
query I
SELECT round(datasketch_cpc_estimate(datasketch_cpc(12, x)))::INT FROM (VALUES
  ('00000000-0000-0000-0000-000000000000'::UUID),
  ('ffffffff-ffff-ffff-ffff-ffffffffffff'::UUID),
  ('80000000-0000-0000-0000-000000000000'::UUID),
  (NULL),
  ('ffffffff-ffff-ffff-ffff-ffffffffffff'::UUID)) v(x)
----
3

statement ok
CREATE TABLE cpc_uuid AS SELECT md5(range::VARCHAR)::UUID AS u, range % 4 AS g FROM range(200000)

query I
SELECT abs(datasketch_cpc_estimate(datasketch_cpc(12, u)) - 200000) / 200000 < 0.05 FROM cpc_uuid
----
true

# A UUID hashes its canonical 16 bytes, so its sketch equals the sketch of uuid::BLOB
query I
SELECT datasketch_cpc(12, u) = datasketch_cpc(12, u::BLOB) FROM cpc_uuid
----
true

query I
SELECT abs(datasketch_cpc_estimate(datasketch_cpc_union(12, s)) - 200000) / 200000 < 0.05 FROM (SELECT datasketch_cpc(12, u) AS s FROM cpc_uuid GROUP BY g)
----
true

query I
SELECT count(*) FROM (SELECT g, datasketch_cpc_estimate(datasketch_cpc(12, u)) AS e FROM cpc_uuid GROUP BY g) WHERE abs(e - 50000) / 50000 > 0.05
----
0

# HUGEINT and UHUGEINT beyond 2^53 count distinctly (an implicit DOUBLE cast once collapsed these 100000 into 1)
query I
SELECT abs(datasketch_cpc_estimate(datasketch_cpc(12, 1267650600228229401496703205376::HUGEINT + range::HUGEINT)) - 100000) / 100000 < 0.05 FROM range(100000)
----
true

query I
SELECT abs(datasketch_cpc_estimate(datasketch_cpc(12, 1267650600228229401496703205376::UHUGEINT + range::UHUGEINT)) - 100000) / 100000 < 0.05 FROM range(100000)
----
true

query I
SELECT round(datasketch_cpc_estimate(datasketch_cpc(12, x)))::INT FROM (VALUES
  ((-170141183460469231731687303715884105728)::HUGEINT), (170141183460469231731687303715884105727::HUGEINT), (0::HUGEINT), (NULL), (0::HUGEINT)) v(x)
----
3

query I
SELECT round(datasketch_cpc_estimate(datasketch_cpc(12, x)))::INT FROM (VALUES
  (0::UHUGEINT), (340282366920938463463374607431768211455::UHUGEINT), (NULL), (0::UHUGEINT)) v(x)
----
2

# Small and negative HUGEINT values count distinctly too
query I
SELECT abs(datasketch_cpc_estimate(datasketch_cpc(12, range::HUGEINT)) - 100000) / 100000 < 0.05 FROM range(-50000, 50000)
----
true

# HUGEINT and UHUGEINT give the same sketch for a value both can hold
query I
SELECT datasketch_cpc(12, x::HUGEINT) = datasketch_cpc(12, x::UHUGEINT) FROM (VALUES (0::UHUGEINT), (5::UHUGEINT), (9223372036854775808::UHUGEINT), (18446744073709551615::UHUGEINT), (18446744073709551616::UHUGEINT), (1267650600228229401496703205376::UHUGEINT)) v(x)
----
true

# From 2^127 up, a UHUGEINT has the 16 bytes of a negative HUGEINT, so it hashes like one
query I
SELECT datasketch_cpc(12, 340282365653287863235145205935065006080::UHUGEINT) = datasketch_cpc(12, (-1267650600228229401496703205376)::HUGEINT)
----
true

# A HUGEINT or UHUGEINT that fits in a BIGINT hashes like that BIGINT, as narrower integers do
query III
SELECT datasketch_cpc(12, range::HUGEINT) = datasketch_cpc(12, range::BIGINT),
       datasketch_cpc(12, (range + 50000)::UHUGEINT) = datasketch_cpc(12, (range + 50000)::BIGINT),
       datasketch_cpc(12, range::HUGEINT) = datasketch_cpc(12, range::INTEGER)
FROM range(-50000, 50000)
----
true	true	true

query II
SELECT datasketch_cpc(12, x::HUGEINT) = datasketch_cpc(12, x), datasketch_cpc(12, x::UHUGEINT) = datasketch_cpc(12, x) FROM (VALUES (9223372036854775807::BIGINT)) v(x)
----
true	true

query I
SELECT datasketch_cpc(12, (-9223372036854775808)::HUGEINT) = datasketch_cpc(12, (-9223372036854775808)::BIGINT)
----
true

# so sketches of sum() results (HUGEINT) merge with sketches of the same BIGINT values
query I
SELECT datasketch_cpc(12, s) = datasketch_cpc(12, s::BIGINT) FROM (SELECT sum(i) AS s FROM range(30000) t(i) GROUP BY i % 1000)
----
true

# just past BIGINT's range, values hash their 16 bytes and stay distinct from the BIGINT extremes
query I
SELECT round(datasketch_cpc_estimate(datasketch_cpc(12, x)))::INT FROM (VALUES
  (9223372036854775807::HUGEINT), (9223372036854775808::HUGEINT), ((-9223372036854775808)::HUGEINT), ((-9223372036854775809)::HUGEINT),
  (9223372036854775807::BIGINT::HUGEINT), ((-9223372036854775808)::BIGINT::HUGEINT)) v(x)
----
4

# Values that share their low 64 bits, or sit on either side of a 64-bit boundary, count separately
query I
SELECT round(datasketch_cpc_estimate(datasketch_cpc(12, x)))::INT FROM (VALUES
  ((-1)::HUGEINT), (18446744073709551615::HUGEINT), (9223372036854775807::HUGEINT), (9223372036854775808::HUGEINT),
  ((-9223372036854775808)::HUGEINT), ((-9223372036854775809)::HUGEINT), (18446744073709551616::HUGEINT)) v(x)
----
7

query I
SELECT round(datasketch_cpc_estimate(datasketch_cpc(12, x)))::INT FROM (VALUES
  (9223372036854775807::UHUGEINT), (9223372036854775808::UHUGEINT), (18446744073709551615::UHUGEINT), (18446744073709551616::UHUGEINT)) v(x)
----
4

query I
SELECT round(datasketch_cpc_estimate(datasketch_cpc(12, x)))::INT FROM (VALUES
  (1267650600228229401496703205376::HUGEINT), (1267650600228229401496703205377::HUGEINT)) v(x)
----
2

# =============================================================================
# EMPTY PARTIAL STATES
# =============================================================================

# Only the first row group matches, so every other thread's partial state is empty. Combining an empty partial
# must leave the sketch unmerged (keeping its HIP estimator): the result equals the single-threaded sketch.
statement ok
SET threads = 8;

statement ok
CREATE TABLE cpc_sparse AS SELECT range AS i FROM range(2000000)

query II
SELECT datasketch_cpc(12, i) = (SELECT datasketch_cpc(12, i) FROM range(1000) r(i)),
       datasketch_cpc_describe(datasketch_cpc(12, i)) LIKE '%HIP estimate%'
FROM cpc_sparse WHERE i < 1000
----
true	true
