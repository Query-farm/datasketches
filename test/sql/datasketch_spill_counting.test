statement ok
SET memory_limit='4GB';

statement ok
SET threads=4;

# Merging stored sketches spills too
statement ok
CREATE TABLE parts AS
SELECT g, p, datasketch_hll(12, v) AS h, datasketch_cpc(12, v) AS c
FROM (SELECT i % 100000 AS g, i % 3 AS p, i AS v FROM range(900000) t(i))
GROUP BY g, p;

statement ok
CREATE MACRO merged() AS TABLE
SELECT g, round(datasketch_hll_estimate(datasketch_hll_union(12, h))) AS h,
       round(datasketch_cpc_estimate(datasketch_cpc_union(12, c))) AS c
FROM parts GROUP BY g;

statement ok
CREATE TABLE expected_merged AS
SELECT count(*) AS n, bit_xor(hash(t)) AS checksum, count(*) FILTER (WHERE abs(h - 9) > 3 OR abs(c - 9) > 3) AS off
FROM merged() t;

query II
SELECT n, off FROM expected_merged;
----
100000	0

statement ok
SET memory_limit='128MB';

query I
SELECT (SELECT bit_xor(hash(t)) FROM merged() t) = (SELECT checksum FROM expected_merged);
----
true

statement ok
SET memory_limit='4GB';

# Exported states finalize to the aggregate's result: buffered states (3 values) and states with a sketch, for every
# input type family
query IIIIII
SELECT finalize(datasketch_hll(12, i) EXPORT_STATE) = datasketch_hll(12, i),
       finalize(datasketch_cpc(12, i) EXPORT_STATE) = datasketch_cpc(12, i),
       finalize(datasketch_hll(12, i::HUGEINT << 70) EXPORT_STATE) = datasketch_hll(12, i::HUGEINT << 70),
       finalize(datasketch_cpc(12, i::HUGEINT << 70) EXPORT_STATE) = datasketch_cpc(12, i::HUGEINT << 70),
       finalize(datasketch_hll(12, 'a long string value ' || i) EXPORT_STATE) = datasketch_hll(12, 'a long string value ' || i),
       finalize(datasketch_cpc(12, ('blob ' || i)::BLOB) EXPORT_STATE) = datasketch_cpc(12, ('blob ' || i)::BLOB)
FROM range(3) t(i);
----
true	true	true	true	true	true

query IIIIII
SELECT finalize(datasketch_hll(12, i) EXPORT_STATE) = datasketch_hll(12, i),
       finalize(datasketch_cpc(12, i) EXPORT_STATE) = datasketch_cpc(12, i),
       finalize(datasketch_hll(12, md5(i::VARCHAR)::UUID) EXPORT_STATE) = datasketch_hll(12, md5(i::VARCHAR)::UUID),
       finalize(datasketch_cpc(12, md5(i::VARCHAR)::UUID) EXPORT_STATE) = datasketch_cpc(12, md5(i::VARCHAR)::UUID),
       finalize(datasketch_hll(12, 'a long string value ' || i) EXPORT_STATE) = datasketch_hll(12, 'a long string value ' || i),
       finalize(datasketch_cpc(12, ('blob ' || i)::BLOB) EXPORT_STATE) = datasketch_cpc(12, ('blob ' || i)::BLOB)
FROM range(100000) t(i);
----
true	true	true	true	true	true

# Exported states of the union aggregates
query II
SELECT round(datasketch_hll_estimate(finalize(datasketch_hll_union(12, h) EXPORT_STATE))) = round(datasketch_hll_estimate(datasketch_hll_union(12, h))),
       round(datasketch_cpc_estimate(finalize(datasketch_cpc_union(12, c) EXPORT_STATE))) = round(datasketch_cpc_estimate(datasketch_cpc_union(12, c)))
FROM parts;
----
true	true

# Combining exported states: buffered with buffered, buffered with a sketch, and two sketches
query IIIIII
SELECT round(datasketch_hll_estimate(finalize(combine(a.h, b.h)))),
       round(datasketch_cpc_estimate(finalize(combine(a.c, b.c)))),
       round(datasketch_hll_estimate(finalize(combine(l.h, a.h)))),
       round(datasketch_cpc_estimate(finalize(combine(a.c, l.c)))),
       round(datasketch_hll_estimate(finalize(combine(l.h, m.h)))),
       round(datasketch_cpc_estimate(finalize(combine(l.c, m.c))))
FROM (SELECT datasketch_hll(12, i) EXPORT_STATE AS h, datasketch_cpc(12, i) EXPORT_STATE AS c FROM range(3) t(i)) a,
     (SELECT datasketch_hll(12, i) EXPORT_STATE AS h, datasketch_cpc(12, i) EXPORT_STATE AS c FROM range(2, 5) t(i)) b,
     (SELECT datasketch_hll(12, i) EXPORT_STATE AS h, datasketch_cpc(12, i) EXPORT_STATE AS c FROM range(100, 200) t(i)) l,
     (SELECT datasketch_hll(12, i) EXPORT_STATE AS h, datasketch_cpc(12, i) EXPORT_STATE AS c FROM range(150, 300) t(i)) m;
----
5.0	5.0	103.0	103.0	200.0	200.0

# A constant input is added once
query II
SELECT (SELECT datasketch_hll(12, 42) FROM range(10000)) = (SELECT datasketch_hll(12, 42)),
       (SELECT datasketch_cpc(12, 42) FROM range(10000)) = (SELECT datasketch_cpc(12, 42));
----
true	true
