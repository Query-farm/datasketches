# name: test/sql/datasketch_hll.test
# description: test datasketch HLL sketches
# group: [datasketches]

# Before we load the extension, this will fail
statement error
SELECT datasketch_hll_is_empty(''::blob);
----
Catalog Error: Scalar Function with name datasketch_hll_is_empty does not exist!

# Require statement will ensure this test is run with this extension loaded
require datasketches

query I
SELECT datasketch_hll(8, 5);
----
\x02\x01\x07\x08\x03\x00\x01\x00{e\xE6\x08\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00

query I
SELECT datasketch_hll_is_empty('\x02\x01\x07\x08\x03\x00\x01\x00{e\xE6\x08\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00');
----
false

query I
SELECT datasketch_hll_estimate('\x02\x01\x07\x08\x03\x00\x01\x00{e\xE6\x08\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00');
----
1

# Do some tests with integers.

statement ok
CREATE TABLE items(id integer)

statement ok
INSERT INTO items(id) select unnest(generate_series(1, 100000));

# Duplicate items shouldn't affect the count.

statement ok
INSERT INTO items(id) select unnest(generate_series(1, 100000));

# HLL estimates should be close to the true count (100000 distinct values)
# With k=12, error should be within ~2-3%
query I
SELECT datasketch_hll_estimate(datasketch_hll(12, id))::int between 95000 and 105000 from items
----
true

# With k=4, error can be much larger (~25%)
query I
SELECT datasketch_hll_estimate(datasketch_hll(4, id))::int between 75000 and 175000 from items
----
true

query I
SELECT datasketch_hll_is_empty(datasketch_hll(12, id)) from items
----
false

# Lower bound should be less than true count but reasonable
query I
SELECT datasketch_hll_lower_bound(datasketch_hll(12, id), 1)::int between 90000 and 105000 from items
----
true

# Upper bound should be greater than true count but reasonable
query I
SELECT datasketch_hll_upper_bound(datasketch_hll(12, id), 1)::int between 95000 and 115000 from items
----
true

query I
SELECT datasketch_hll_lg_config_k(datasketch_hll(12, id)) from items
----
12

query I
SELECT datasketch_hll_is_compact(datasketch_hll(12, id)) from items
----
false


query I
SELECT datasketch_hll_describe(datasketch_hll(4, id), true, false) like '%HLL sketch summary%' from items
----
true

# Test with strings

statement ok
CREATE TABLE employees(name string)

statement ok
INSERT INTO employees(name) VALUES
('John Doe'), ('Jane Smith'), ('Michael Johnson'), ('Emily Davis'), ('Chris Brown'), ('Sarah Wilson'), ('David Martinez'),('Sophia Anderson'), ('Daniel Lee'),('Olivia Taylor');

# 10 distinct names, estimate should be close
query I
SELECT datasketch_hll_estimate(datasketch_hll(4, name))::int between 8 and 15 from employees
----
true

# Grouped query - each group has 50 distinct values, estimates should be close
query I
select datasketch_hll_estimate(datasketch_hll(14, x))::int between 45 and 55 from unnest(range(100)) t(x) group by x % 2
----
true
true

statement ok
CREATE TABLE sketches (sketch sketch_hll)

statement ok
INSERT INTO sketches (sketch) select datasketch_hll(12, id) from items where mod(id, 3) == 0

statement ok
INSERT INTO sketches (sketch) select datasketch_hll(12, id) from items where mod(id, 3) == 1

statement ok
INSERT INTO sketches (sketch) select datasketch_hll(12, id) from items where mod(id, 3) == 2

query I
select datasketch_hll_is_empty(datasketch_hll_union(12, sketch)) from sketches
----
false

statement ok
select datasketch_hll_estimate(datasketch_hll_union(12, sketch))::int from sketches

# Test error handling for invalid/corrupted sketch data
statement error
SELECT datasketch_hll_estimate('\x00\x01\x02\x03'::blob);
----
Invalid Input Error: Failed to deserialize HLL sketch

statement error
SELECT datasketch_hll_is_empty('\xDE\xAD\xBE\xEF'::blob);
----
Invalid Input Error: Failed to deserialize HLL sketch

# Test with empty blob
statement error
SELECT datasketch_hll_estimate(''::blob);
----
Invalid Input Error: Failed to deserialize HLL sketch

# =============================================================================
# COMPREHENSIVE UNION TESTS
# =============================================================================

# Test union of multiple sketches from partitioned data with non-overlapping values
statement ok
CREATE TABLE union_data(value int, partition_id int)

statement ok
INSERT INTO union_data SELECT unnest(generate_series(1, 10000)), 1

statement ok
INSERT INTO union_data SELECT unnest(generate_series(10001, 20000)), 2

statement ok
INSERT INTO union_data SELECT unnest(generate_series(20001, 30000)), 3

# Create sketches per partition
statement ok
CREATE TABLE partition_sketches AS
SELECT partition_id, datasketch_hll(12, value) as sketch
FROM union_data
GROUP BY partition_id

# Verify we have 3 partition sketches
query I
SELECT count(*) FROM partition_sketches
----
3

# Each partition has 10000 distinct values
query I
SELECT datasketch_hll_estimate(sketch)::int between 9500 and 10500 FROM partition_sketches ORDER BY partition_id LIMIT 1
----
true

# Union all partition sketches - should have ~30000 distinct values
query I
SELECT datasketch_hll_estimate(datasketch_hll_union(12, sketch))::int between 28500 and 31500 FROM partition_sketches
----
true

# Verify union is not empty
query I
SELECT datasketch_hll_is_empty(datasketch_hll_union(12, sketch)) FROM partition_sketches
----
false

# Union should have lg_config_k from the bind parameter
query I
SELECT datasketch_hll_lg_config_k(datasketch_hll_union(12, sketch)) FROM partition_sketches
----
12

# Test union with overlapping data
statement ok
CREATE TABLE overlap_union_data(value int, group_id int)

statement ok
INSERT INTO overlap_union_data SELECT unnest(generate_series(1, 50000)), 1

statement ok
INSERT INTO overlap_union_data SELECT unnest(generate_series(25000, 75000)), 2

statement ok
CREATE TABLE overlap_union_sketches AS
SELECT group_id, datasketch_hll(14, value) as sketch
FROM overlap_union_data
GROUP BY group_id

# Group 1 has 50000 distinct, Group 2 has 50001 distinct
# Union should have 75000 distinct (1-75000)
query I
SELECT datasketch_hll_estimate(datasketch_hll_union(14, sketch))::int between 72000 and 78000 FROM overlap_union_sketches
----
true

# Test union with different K values
statement ok
CREATE TABLE k_union_sketches AS
SELECT datasketch_hll(8, value) as sketch FROM union_data WHERE partition_id = 1
UNION ALL
SELECT datasketch_hll(14, value) as sketch FROM union_data WHERE partition_id = 2

# Verify union works with different K values and produces reasonable estimate
query I
SELECT datasketch_hll_estimate(datasketch_hll_union(10, sketch))::int between 18000 and 22000 FROM k_union_sketches
----
true

# Test union of single sketch (edge case)
query I
SELECT datasketch_hll_estimate(datasketch_hll_union(12, sketch))::int between 9500 and 10500
FROM (SELECT datasketch_hll(12, value) as sketch FROM union_data WHERE partition_id = 1) single_sketch
----
true

# Test union preserves accuracy - lower_bound/upper_bound on union
query I
SELECT datasketch_hll_lower_bound(datasketch_hll_union(12, sketch), 1)::int between 27000 and 31000 FROM partition_sketches
----
true

query I
SELECT datasketch_hll_upper_bound(datasketch_hll_union(12, sketch), 1)::int between 29000 and 33000 FROM partition_sketches
----
true

# Test union with string values
statement ok
CREATE TABLE string_union_data(name varchar, source_id int)

statement ok
INSERT INTO string_union_data
SELECT 'user_' || x, 1 FROM generate_series(1, 1000) t(x)
UNION ALL
SELECT 'user_' || x, 2 FROM generate_series(500, 1500) t(x)

statement ok
CREATE TABLE string_union_sketches AS
SELECT source_id, datasketch_hll(10, name) as sketch
FROM string_union_data
GROUP BY source_id

# Union should have ~1500 distinct strings (user_1 to user_1500)
query I
SELECT datasketch_hll_estimate(datasketch_hll_union(10, sketch))::int between 1400 and 1600 FROM string_union_sketches
----
true

# Test union with GROUP BY categories
statement ok
CREATE TABLE category_union_data(category varchar, user_id int)

statement ok
INSERT INTO category_union_data
SELECT 'electronics', unnest(generate_series(1, 5000))
UNION ALL
SELECT 'clothing', unnest(generate_series(2500, 7500))
UNION ALL
SELECT 'food', unnest(generate_series(5000, 10000))

statement ok
CREATE TABLE category_union_sketches AS
SELECT category, datasketch_hll(12, user_id) as sketch
FROM category_union_data
GROUP BY category

# Each category has ~5000 distinct users
# Union should have ~10000 distinct users (1-10000)
query I
SELECT datasketch_hll_estimate(datasketch_hll_union(12, sketch))::int between 9500 and 10500 FROM category_union_sketches
----
true

# Test describe on union result
query I
SELECT datasketch_hll_describe(datasketch_hll_union(12, sketch), true, false) like '%HLL sketch summary%' FROM partition_sketches
----
true

# Test is_compact on union result
query I
SELECT datasketch_hll_is_compact(datasketch_hll_union(12, sketch)) FROM partition_sketches
----
false

# =============================================================================
# UNION STATE: PARALLEL MERGES, MANY-ROW UNIONS, REPEATED INPUTS
# =============================================================================

statement ok
SET threads = 8;

statement ok
CREATE TABLE hll_par AS SELECT i AS v, i % 2000 AS g FROM range(400000) t(i)

# 2000 groups of 200 distinct values: partial states on every thread, merged per group
query I
SELECT count(*) FROM (SELECT g, datasketch_hll_estimate(datasketch_hll(12, v)) AS e FROM hll_par GROUP BY g) WHERE abs(e - 200) > 10
----
0

# 20 groups of 20000 distinct values: large partial states merged per group
query I
SELECT count(*) FROM (SELECT g % 20 AS h, datasketch_hll_estimate(datasketch_hll(12, v)) AS e FROM hll_par GROUP BY h) WHERE abs(e - 20000) / 20000 > 0.05
----
0

statement ok
CREATE TABLE hll_par_sketches AS SELECT g, datasketch_hll(12, v) AS s FROM hll_par GROUP BY g

# Union of 2000 sketches into one group
query I
SELECT abs(datasketch_hll_estimate(datasketch_hll_union(12, s)) - 400000) / 400000 < 0.05 FROM hll_par_sketches
----
true

# Grouped unions agree with and without parallelism
statement ok
SET threads = 1;

statement ok
CREATE TABLE hll_u1 AS SELECT g % 10 AS h, datasketch_hll_estimate(datasketch_hll_union(12, s)) AS e FROM hll_par_sketches GROUP BY h

statement ok
SET threads = 8;

query I
SELECT count(*) FROM hll_u1 JOIN (SELECT g % 10 AS h, datasketch_hll_estimate(datasketch_hll_union(12, s)) AS e FROM hll_par_sketches GROUP BY h) u8 USING (h) WHERE abs(hll_u1.e - u8.e) / hll_u1.e > 0.01
----
0

# A repeated value counts once
query I
SELECT datasketch_hll_estimate(datasketch_hll(12, 42))::INT FROM range(10000)
----
1

# Unioning the same sketch many times equals unioning it twice
statement ok
CREATE TABLE hll_one AS SELECT datasketch_hll(12, v) AS s FROM hll_par WHERE g < 100

query I
SELECT (SELECT datasketch_hll_estimate(datasketch_hll_union(12, s)) FROM hll_one, range(5000)) = (SELECT datasketch_hll_estimate(datasketch_hll_union(12, s)) FROM hll_one, range(2))
----
true

# A running window over the sketch merges states many times
query I
SELECT count(*) FROM (SELECT datasketch_hll_estimate(datasketch_hll(12, v) OVER (ORDER BY v ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)) AS e, row_number() OVER (ORDER BY v) AS n FROM (SELECT v FROM hll_par WHERE v < 5000)) WHERE abs(e - n) / n > 0.05
----
0

# Unioning sketches of a smaller lg_k keeps their lg_k
query I
SELECT datasketch_hll_lg_config_k(datasketch_hll_union(12, s)) FROM (SELECT datasketch_hll(10, v) AS s FROM hll_par GROUP BY g % 4)
----
10

# Unioning sketches of a larger lg_k reduces them to the bound lg_k
query I
SELECT datasketch_hll_lg_config_k(datasketch_hll_union(10, s)) FROM (SELECT datasketch_hll(12, v) AS s FROM hll_par GROUP BY g % 4)
----
10

# =============================================================================
# UUID, HUGEINT AND UHUGEINT INPUTS
# =============================================================================

query I
SELECT round(datasketch_hll_estimate(datasketch_hll(12, '00000000-0000-0000-0000-000000000001'::UUID)))::INT
----
1

# The extreme UUID values are distinct, NULLs are ignored and repeats count once
query I
SELECT round(datasketch_hll_estimate(datasketch_hll(12, x)))::INT FROM (VALUES
  ('00000000-0000-0000-0000-000000000000'::UUID),
  ('ffffffff-ffff-ffff-ffff-ffffffffffff'::UUID),
  ('80000000-0000-0000-0000-000000000000'::UUID),
  (NULL),
  ('ffffffff-ffff-ffff-ffff-ffffffffffff'::UUID)) v(x)
----
3

statement ok
CREATE TABLE hll_uuid AS SELECT md5(range::VARCHAR)::UUID AS u, range % 4 AS g FROM range(200000)

query I
SELECT abs(datasketch_hll_estimate(datasketch_hll(12, u)) - 200000) / 200000 < 0.05 FROM hll_uuid
----
true

# A UUID hashes its canonical 16 bytes, so its sketch equals the sketch of uuid::BLOB
query I
SELECT datasketch_hll(12, u) = datasketch_hll(12, u::BLOB) FROM hll_uuid
----
true

query I
SELECT abs(datasketch_hll_estimate(datasketch_hll_union(12, s)) - 200000) / 200000 < 0.05 FROM (SELECT datasketch_hll(12, u) AS s FROM hll_uuid GROUP BY g)
----
true

query I
SELECT count(*) FROM (SELECT g, datasketch_hll_estimate(datasketch_hll(12, u)) AS e FROM hll_uuid GROUP BY g) WHERE abs(e - 50000) / 50000 > 0.05
----
0

# HUGEINT and UHUGEINT used to be cast to DOUBLE, which collapsed values beyond 2^53: these 100000 counted as 1
query I
SELECT abs(datasketch_hll_estimate(datasketch_hll(12, 1267650600228229401496703205376::HUGEINT + range::HUGEINT)) - 100000) / 100000 < 0.05 FROM range(100000)
----
true

query I
SELECT abs(datasketch_hll_estimate(datasketch_hll(12, 1267650600228229401496703205376::UHUGEINT + range::UHUGEINT)) - 100000) / 100000 < 0.05 FROM range(100000)
----
true

query I
SELECT round(datasketch_hll_estimate(datasketch_hll(12, x)))::INT FROM (VALUES
  ((-170141183460469231731687303715884105728)::HUGEINT), (170141183460469231731687303715884105727::HUGEINT), (0::HUGEINT), (NULL), (0::HUGEINT)) v(x)
----
3

query I
SELECT round(datasketch_hll_estimate(datasketch_hll(12, x)))::INT FROM (VALUES
  (0::UHUGEINT), (340282366920938463463374607431768211455::UHUGEINT), (NULL), (0::UHUGEINT)) v(x)
----
2

# A value that converts to DOUBLE exactly keeps its DOUBLE hash, so existing HUGEINT sketches still merge
query I
SELECT datasketch_hll(12, range::HUGEINT) = datasketch_hll(12, range::DOUBLE) FROM range(-1000, 100000)
----
true

query I
SELECT datasketch_hll(12, range::UHUGEINT) = datasketch_hll(12, range::DOUBLE) FROM range(100000)
----
true

query I
SELECT datasketch_hll(12, 1267650600228229401496703205376::HUGEINT) = datasketch_hll(12, 1267650600228229401496703205376::DOUBLE)
----
true

# ... while a neighbour that DOUBLE can't represent counts separately
query I
SELECT round(datasketch_hll_estimate(datasketch_hll(12, x)))::INT FROM (VALUES
  (1267650600228229401496703205376::HUGEINT), (1267650600228229401496703205377::HUGEINT)) v(x)
----
2

# Bounds take 1, 2 or 3 standard deviations
statement error
SELECT datasketch_hll_lower_bound(datasketch_hll(12, i), 5) FROM range(10) t(i)
----
datasketch_hll_lower_bound: num_std_devs must be 1, 2 or 3, got 5

# Casting to sketch_hll gives the sketch type
query I
SELECT typeof(NULL::sketch_hll)
----
sketch_hll
