# name: test/sql/datasketch_frequent_items_exact_keys.test
# description: Frequent Items sketches must keep distinct numeric items distinct (exact item-to-string conversion)
# group: [datasketches]

require datasketches

# DOUBLE values that agree to six decimal places are still distinct items.
statement ok
CREATE TABLE d AS SELECT * FROM (VALUES (0.1234567::DOUBLE), (0.1234567::DOUBLE), (0.1234568::DOUBLE), (1e-7::DOUBLE), (1e-9::DOUBLE), (1e-9::DOUBLE), (1e-9::DOUBLE)) t(v);

statement ok
CREATE TABLE ds AS SELECT datasketch_frequent_items(v) AS s FROM d;

query IIIII
SELECT
    datasketch_frequent_items_num_active(s),
    datasketch_frequent_items_estimate(s, 0.1234567::DOUBLE),
    datasketch_frequent_items_estimate(s, 0.1234568::DOUBLE),
    datasketch_frequent_items_estimate(s, 1e-7::DOUBLE),
    datasketch_frequent_items_estimate(s, 1e-9::DOUBLE)
FROM ds;
----
4	2	1	1	3

# A value that was never added is not found, even if it is close to one that was.
query II
SELECT
    datasketch_frequent_items_estimate(s, 0.12345671::DOUBLE),
    datasketch_frequent_items_estimate(s, 0.123456::DOUBLE)
FROM ds;
----
0	0

# Items are stored the way DuckDB casts the value to VARCHAR (shortest round-trip form).
query II rowsort
SELECT f.item, f.estimate FROM (SELECT unnest(datasketch_frequent_items_get_frequent(s, 'NO_FALSE_NEGATIVES')) AS f FROM ds);
----
0.1234567	2
0.1234568	1
1e-07	1
1e-09	3

query I
SELECT bool_and(f.item = CAST(v AS VARCHAR))
FROM (SELECT unnest(datasketch_frequent_items_get_frequent(datasketch_frequent_items(v), 'NO_FALSE_NEGATIVES')) AS f, v
      FROM d GROUP BY v);
----
true

# Extreme and special DOUBLE values.
query IIII
WITH s AS (SELECT datasketch_frequent_items(v) AS s FROM (VALUES (1.7976931348623157e308::DOUBLE), (5e-324::DOUBLE), ('inf'::DOUBLE), ('-inf'::DOUBLE), (-0.0::DOUBLE), (0.0::DOUBLE)) t(v))
SELECT
    datasketch_frequent_items_estimate(s, 1.7976931348623157e308::DOUBLE),
    datasketch_frequent_items_estimate(s, 5e-324::DOUBLE),
    datasketch_frequent_items_estimate(s, 'inf'::DOUBLE),
    datasketch_frequent_items_num_active(s)
FROM s;
----
1	1	1	6

# FLOAT uses the shortest form for single precision (0.1, not 0.10000000149011612).
query II rowsort
SELECT f.item, f.estimate FROM (
    SELECT unnest(datasketch_frequent_items_get_frequent(datasketch_frequent_items(v), 'NO_FALSE_NEGATIVES')) AS f
    FROM (VALUES (0.1::FLOAT), (0.1::FLOAT), (1.0000001::FLOAT), (1.0::FLOAT)) t(v));
----
0.1	2
1.0	1
1.0000001	1

query II
WITH s AS (SELECT datasketch_frequent_items(v) AS s FROM (VALUES (0.1::FLOAT), (0.1::FLOAT), (1.0000001::FLOAT), (1.0::FLOAT)) t(v))
SELECT datasketch_frequent_items_estimate(s, 1.0000001::FLOAT), datasketch_frequent_items_estimate(s, 0.1::FLOAT) FROM s;
----
1	2

# Weighted sketches use the same conversion.
query III
WITH s AS (SELECT datasketch_frequent_items_weighted(v, w) AS s FROM (VALUES (0.1234567::DOUBLE, 5::BIGINT), (0.1234568::DOUBLE, 7::BIGINT)) t(v, w))
SELECT
    datasketch_frequent_items_estimate(s, 0.1234567::DOUBLE),
    datasketch_frequent_items_estimate(s, 0.1234568::DOUBLE),
    datasketch_frequent_items_num_active(s)
FROM s;
----
5	7	2

# Integers are exact, including values a DOUBLE cannot represent.
query IIII
WITH s AS (SELECT datasketch_frequent_items(v) AS s FROM (VALUES (9007199254740993::BIGINT), (9007199254740992::BIGINT), (9007199254740992::BIGINT)) t(v)),
     u AS (SELECT datasketch_frequent_items(v) AS s FROM (VALUES (18446744073709551615::UBIGINT), (18446744073709551614::UBIGINT)) t(v))
SELECT
    datasketch_frequent_items_estimate(s.s, 9007199254740993::BIGINT),
    datasketch_frequent_items_estimate(s.s, 9007199254740992::BIGINT),
    datasketch_frequent_items_estimate(u.s, 18446744073709551615::UBIGINT),
    datasketch_frequent_items_num_active(u.s)
FROM s, u;
----
1	2	1	2

# lg_max_k is validated instead of being truncated to 8 bits.
statement error
SELECT datasketch_frequent_items(2, v) FROM d;
----
lg_max_k must be between 3 and 30

statement error
SELECT datasketch_frequent_items(264, v) FROM d;
----
lg_max_k must be between 3 and 30

statement error
SELECT datasketch_frequent_items_weighted(31, v, 1::BIGINT) FROM d;
----
lg_max_k must be between 3 and 30

query I
SELECT datasketch_frequent_items_estimate(datasketch_frequent_items(3, v), 1e-9::DOUBLE) FROM d;
----
3
