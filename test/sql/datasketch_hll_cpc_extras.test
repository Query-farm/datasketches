# name: test/sql/datasketch_hll_cpc_extras.test
# description: HLL target types, composite estimate and scalar merges of HLL and CPC sketches
# group: [datasketches]

require datasketches

statement ok
CREATE TABLE ids AS SELECT i::BIGINT AS id FROM range(1, 100001) t(i);

statement ok
CREATE TABLE a AS SELECT i::BIGINT AS id FROM range(1, 61) t(i);

statement ok
CREATE TABLE b AS SELECT i::BIGINT AS id FROM range(41, 101) t(i);

# ---------------------------------------------------------------- HLL target type
query IIII
SELECT
    datasketch_hll_target_type(datasketch_hll(12, id)),
    datasketch_hll_target_type(datasketch_hll(12, id, 'HLL_4')),
    datasketch_hll_target_type(datasketch_hll(12, id, 'hll_6')),
    datasketch_hll_target_type(datasketch_hll(12, id, 'HLL_8'))
FROM a;
----
HLL_4	HLL_4	HLL_6	HLL_8

query I
SELECT datasketch_hll_target_type(datasketch_hll(12, name, 'HLL_8')) FROM (VALUES ('x'), ('y')) t(name);
----
HLL_8

statement error
SELECT datasketch_hll(12, id, 'HLL_5') FROM a;
----
HLL target_type must be one of 'HLL_4', 'HLL_6' or 'HLL_8'

statement error
SELECT datasketch_hll(12, id, NULL::VARCHAR) FROM a;
----
HLL target_type cannot be NULL

# The encodings hold the same registers, so they agree on the register-based estimate;
# wider registers take more space.
statement ok
CREATE TABLE typed AS SELECT
    datasketch_hll(12, id) AS h4,
    datasketch_hll(12, id, 'HLL_6') AS h6,
    datasketch_hll(12, id, 'HLL_8') AS h8
FROM ids;

query III
SELECT
    datasketch_hll_composite_estimate(h4) = datasketch_hll_composite_estimate(h6),
    datasketch_hll_composite_estimate(h4) = datasketch_hll_composite_estimate(h8),
    octet_length(h4::BLOB) < octet_length(h8::BLOB)
FROM typed;
----
true	true	true

query II
SELECT
    datasketch_hll_composite_estimate(h8) BETWEEN 95000 AND 105000,
    datasketch_hll_target_type(h8)
FROM typed;
----
true	HLL_8

# The union aggregate keeps HLL_4 by default and accepts a target type.
query II
SELECT
    datasketch_hll_target_type(datasketch_hll_union(12, s)),
    datasketch_hll_target_type(datasketch_hll_union(12, s, 'HLL_6'))
FROM (SELECT datasketch_hll(12, id, 'HLL_8') AS s FROM ids GROUP BY id % 4);
----
HLL_4	HLL_6

query I
SELECT datasketch_hll_composite_estimate(datasketch_hll_union(12, s, 'HLL_8')) = (SELECT datasketch_hll_composite_estimate(h4) FROM typed)
FROM (SELECT datasketch_hll(12, id) AS s FROM ids GROUP BY id % 4);
----
true

# ---------------------------------------------------------------- HLL composite estimate
query II
SELECT round(datasketch_hll_composite_estimate(datasketch_hll(12, id))), round(datasketch_hll_estimate(datasketch_hll(12, id))) FROM a;
----
60.0	60.0

# ---------------------------------------------------------------- HLL scalar merge
statement ok
CREATE TABLE hs AS SELECT (SELECT datasketch_hll(12, id) FROM a) AS sa, (SELECT datasketch_hll(12, id) FROM b) AS sb, (SELECT datasketch_hll(10, id, 'HLL_8') FROM b WHERE id > 0) AS sb10;

query IIII
SELECT
    round(datasketch_hll_estimate(datasketch_hll_merge(sa, sb))),
    datasketch_hll_lg_config_k(datasketch_hll_merge(sa, sb)),
    datasketch_hll_target_type(datasketch_hll_merge(sa, sb)),
    typeof(datasketch_hll_merge(sa, sb))
FROM hs;
----
100.0	12	HLL_4	sketch_hll

# Mixed lg_k: the first sketch picks the target type. Sparse (list/set mode) inputs keep the larger lg_k...
query IIII
SELECT
    datasketch_hll_lg_config_k(datasketch_hll_merge(sa, sb10)),
    datasketch_hll_target_type(datasketch_hll_merge(sa, sb10)),
    datasketch_hll_target_type(datasketch_hll_merge(sb10, sa)),
    round(datasketch_hll_estimate(datasketch_hll_merge(sb10, sa)))
FROM hs;
----
12	HLL_4	HLL_8	100.0

# ... while dense (HLL mode) inputs are reduced to the smaller one.
query III
WITH d AS (
    SELECT (SELECT datasketch_hll(12, id) FROM ids WHERE id <= 50000) AS d12,
           (SELECT datasketch_hll(10, id) FROM ids WHERE id > 50000) AS d10
)
SELECT
    datasketch_hll_lg_config_k(datasketch_hll_merge(d12, d10)),
    datasketch_hll_lg_config_k(datasketch_hll_merge(d10, d12)),
    datasketch_hll_estimate(datasketch_hll_merge(d12, d10)) BETWEEN 90000 AND 110000
FROM d;
----
10	10	true

query I
SELECT datasketch_hll_merge(sa, NULL) IS NULL FROM hs;
----
true

# Merging a sketch with itself does not change the estimate.
query I
SELECT round(datasketch_hll_estimate(datasketch_hll_merge(sa, sa))) FROM hs;
----
60.0

# ---------------------------------------------------------------- CPC scalar merge
statement ok
CREATE TABLE cs AS SELECT (SELECT datasketch_cpc(12, id) FROM a) AS sa, (SELECT datasketch_cpc(12, id) FROM b) AS sb, (SELECT datasketch_cpc(10, id) FROM b WHERE id > 0) AS sb10;

query III
SELECT
    round(datasketch_cpc_estimate(datasketch_cpc_merge(sa, sb))),
    round(datasketch_cpc_estimate(datasketch_cpc_merge(sa, sb10))),
    typeof(datasketch_cpc_merge(sa, sb))
FROM cs;
----
100.0	100.0	sketch_cpc

query II
SELECT datasketch_cpc_merge(sa, NULL) IS NULL, round(datasketch_cpc_estimate(datasketch_cpc_merge(sa, sa))) FROM cs;
----
true	60.0

query I
SELECT datasketch_cpc_describe(datasketch_cpc_merge(sa, sb10)) LIKE '%lg_k%10%' FROM cs;
----
true
