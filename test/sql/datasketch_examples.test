# name: test/sql/datasketch_examples.test
# description: every example in the Theta, Tuple, array-of-doubles, Frequent Items, Bloom filter, Count-Min, VarOpt, EBPPS and Density function descriptions runs
# group: [datasketches]

# The generated sketch functions (Quantiles, KLL, REQ, TDigest, HLL, CPC) are covered by
# datasketch_generated_examples.test, which codegen/generator.py writes. When an example below changes, update
# both the list and the statement that runs it.

require datasketches

statement ok
CREATE TABLE documented_examples(example VARCHAR);

statement ok
