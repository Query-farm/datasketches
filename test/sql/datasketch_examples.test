# Every registered example of these functions is one of the examples run below
query II
SELECT count(*), count(*) FILTER (WHERE example NOT IN (SELECT example FROM documented_examples))
FROM (SELECT DISTINCT unnest(examples) AS example FROM duckdb_functions()
      WHERE function_name LIKE 'datasketch%'
        AND NOT regexp_matches(function_name, '^datasketch_(quantiles|kll|req|tdigest|hll|cpc)(_|$)'));
