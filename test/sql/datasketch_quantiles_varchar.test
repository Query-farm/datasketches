# name: test/sql/datasketch_quantiles_varchar.test
# description: KLL and Quantiles sketches over VARCHAR items
# group: [datasketches]

require datasketches

statement ok
CREATE TABLE words AS SELECT * FROM (VALUES ('pear'), ('apple'), ('fig'), ('banana'), ('cherry'), ('apple'), ('date'), ('elderberry'), ('grape'), ('apple')) t(w);

# ---------------------------------------------------------------- kll
statement ok
CREATE TABLE kll_w AS SELECT datasketch_kll(200, w) AS s FROM words;

query IIIII
SELECT
    typeof(s),
    datasketch_kll_n(s),
    datasketch_kll_min_item(s),
    datasketch_kll_max_item(s),
    datasketch_kll_is_estimation_mode(s)
FROM kll_w;
----
sketch_kll_varchar	10	apple	pear	false

query III
SELECT
    datasketch_kll_quantile(s, 0.5, true),
    datasketch_kll_rank(s, 'apple', true),
    datasketch_kll_rank(s, 'apple', false)
FROM kll_w;
----
cherry	0.3	0.0

query II
SELECT
    datasketch_kll_quantiles(s, [0.0, 0.3, 0.31, 1.0, NULL], true),
    typeof(datasketch_kll_quantiles(s, [0.5], true))
FROM kll_w;
----
[apple, apple, banana, pear, NULL]	VARCHAR[]

query I
SELECT datasketch_kll_ranks(s, ['apple', 'b', 'zebra', NULL], true) FROM kll_w;
----
[0.3, 0.3, 1.0, NULL]

query II
SELECT datasketch_kll_cdf(s, ['b', 'e'], true), datasketch_kll_pmf(s, ['b', 'e'], true) FROM kll_w;
----
[0.3, 0.6, 1.0]	[0.3, 0.3, 0.4]

query I
SELECT datasketch_kll_sorted_view(s) FROM kll_w;
----
[{'item': apple, 'weight': 1, 'cumulative_weight': 1}, {'item': apple, 'weight': 1, 'cumulative_weight': 2}, {'item': apple, 'weight': 1, 'cumulative_weight': 3}, {'item': banana, 'weight': 1, 'cumulative_weight': 4}, {'item': cherry, 'weight': 1, 'cumulative_weight': 5}, {'item': date, 'weight': 1, 'cumulative_weight': 6}, {'item': elderberry, 'weight': 1, 'cumulative_weight': 7}, {'item': fig, 'weight': 1, 'cumulative_weight': 8}, {'item': grape, 'weight': 1, 'cumulative_weight': 9}, {'item': pear, 'weight': 1, 'cumulative_weight': 10}]

# Long strings (not inlined in DuckDB's string representation) survive the round trip.
query II
SELECT
    datasketch_kll_max_item(datasketch_kll(200, w)),
    datasketch_kll_quantiles(datasketch_kll(200, w), [0.0, 1.0], true)
FROM (VALUES (repeat('x', 40)), (repeat('a', 20) || 'z'), ('')) t(w);
----
xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx	['', xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx]

# Sketches of groups merge into the sketch of the whole.
query II
SELECT datasketch_kll_n(datasketch_kll(200, s)), datasketch_kll_quantile(datasketch_kll(200, s), 0.5, true)
FROM (SELECT datasketch_kll(200, w) AS s FROM words GROUP BY length(w));
----
10	cherry

# The sketch survives a BLOB round trip.
query I
SELECT datasketch_kll_min_item(s::BLOB::sketch_kll_varchar) FROM kll_w;
----
apple

query I
SELECT datasketch_kll_describe(s, false, false) LIKE '%N%10%' FROM kll_w;
----
true

# ---------------------------------------------------------------- quantiles
statement ok
CREATE TABLE quantiles_w AS SELECT datasketch_quantiles(128, w) AS s FROM words;

query IIIII
SELECT
    typeof(s),
    datasketch_quantiles_n(s),
    datasketch_quantiles_min_item(s),
    datasketch_quantiles_max_item(s),
    datasketch_quantiles_is_estimation_mode(s)
FROM quantiles_w;
----
sketch_quantiles_varchar	10	apple	pear	false

query III
SELECT
    datasketch_quantiles_quantile(s, 0.5, true),
    datasketch_quantiles_rank(s, 'apple', true),
    datasketch_quantiles_rank(s, 'apple', false)
FROM quantiles_w;
----
cherry	0.3	0.0

query II
SELECT
    datasketch_quantiles_quantiles(s, [0.0, 0.3, 0.31, 1.0, NULL], true),
    typeof(datasketch_quantiles_quantiles(s, [0.5], true))
FROM quantiles_w;
----
[apple, apple, banana, pear, NULL]	VARCHAR[]

query I
SELECT datasketch_quantiles_ranks(s, ['apple', 'b', 'zebra', NULL], true) FROM quantiles_w;
----
[0.3, 0.3, 1.0, NULL]

query II
SELECT datasketch_quantiles_cdf(s, ['b', 'e'], true), datasketch_quantiles_pmf(s, ['b', 'e'], true) FROM quantiles_w;
----
[0.3, 0.6, 1.0]	[0.3, 0.3, 0.4]

query I
SELECT datasketch_quantiles_sorted_view(s) FROM quantiles_w;
----
[{'item': apple, 'weight': 1, 'cumulative_weight': 1}, {'item': apple, 'weight': 1, 'cumulative_weight': 2}, {'item': apple, 'weight': 1, 'cumulative_weight': 3}, {'item': banana, 'weight': 1, 'cumulative_weight': 4}, {'item': cherry, 'weight': 1, 'cumulative_weight': 5}, {'item': date, 'weight': 1, 'cumulative_weight': 6}, {'item': elderberry, 'weight': 1, 'cumulative_weight': 7}, {'item': fig, 'weight': 1, 'cumulative_weight': 8}, {'item': grape, 'weight': 1, 'cumulative_weight': 9}, {'item': pear, 'weight': 1, 'cumulative_weight': 10}]

# Long strings (not inlined in DuckDB's string representation) survive the round trip.
query II
SELECT
    datasketch_quantiles_max_item(datasketch_quantiles(128, w)),
    datasketch_quantiles_quantiles(datasketch_quantiles(128, w), [0.0, 1.0], true)
FROM (VALUES (repeat('x', 40)), (repeat('a', 20) || 'z'), ('')) t(w);
----
xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx	['', xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx]

# Sketches of groups merge into the sketch of the whole.
query II
SELECT datasketch_quantiles_n(datasketch_quantiles(128, s)), datasketch_quantiles_quantile(datasketch_quantiles(128, s), 0.5, true)
FROM (SELECT datasketch_quantiles(128, w) AS s FROM words GROUP BY length(w));
----
10	cherry

# The sketch survives a BLOB round trip.
query I
SELECT datasketch_quantiles_min_item(s::BLOB::sketch_quantiles_varchar) FROM quantiles_w;
----
apple

query I
SELECT datasketch_quantiles_describe(s, false, false) LIKE '%N%10%' FROM quantiles_w;
----
true
